# Supabase project settings (Project Settings > API). The anon/publishable key is safe to expose; Row Level Security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The Web client ID of the Google OAuth client (Google Cloud > APIs & Services > Credentials), the same one set in the Supabase Google provider.
VITE_GOOGLE_CLIENT_ID=
